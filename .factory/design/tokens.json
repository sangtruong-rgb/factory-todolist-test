{
  "color": {
    "bg": { "$type": "color", "$value": "#FAFAF7", "$extensions": { "dark": "#151614" } },
    "surface": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "dark": "#1D1E1C" } },
    "ink": { "$type": "color", "$value": "#1C1C1A", "$extensions": { "dark": "#ECEBE5" } },
    "muted": { "$type": "color", "$value": "#6B6B66", "$extensions": { "dark": "#A3A29B" } },
    "line": { "$type": "color", "$value": "#E4E3DD", "$extensions": { "dark": "#2E2F2C" } },
    "hover": { "$type": "color", "$value": "#EFEEE9", "$extensions": { "dark": "#262725" } },
    "accent": { "$type": "color", "$value": "#2F6F5E", "$extensions": { "dark": "#7DBFA9" } },
    "accent-ink": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "dark": "#10241D" } },
    "danger": { "$type": "color", "$value": "#B4432E", "$extensions": { "dark": "#F08A70" } }
